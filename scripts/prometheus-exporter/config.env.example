# Prometheus Configuration
PROMETHEUS_URL=http://54.160.217.166:9090

# Write database (collector / table creation only)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=pricefeed

# Read-only database (ALL API handlers — required for API_MODE / COMBINED_MODE)
# Host/port/name fall back to DB_* when unset. User/password must be set; API fails closed.
DB_READONLY_HOST=localhost
DB_READONLY_PORT=5432
DB_READONLY_USER=readonly_user
DB_READONLY_PASSWORD=replace_with_readonly_user_password
DB_READONLY_NAME=pricefeed

# Query limits (API / freeform SQL)
QUERY_TIMEOUT_SECONDS=120
QUERY_MAX_ROWS=500000

# API Configuration
API_PASSWORD=admin123
API_PORT=8080

# Application Mode (set one)
COMBINED_MODE=true
# API_MODE=false
# SCHEDULER_MODE=false
# RESTART_MODE=false
