[Unit]
Description=Layer chain-monitor (RPC block alerts)
Documentation=https://github.com/tellor-io/layer/tree/main/scripts/chain-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chain-monitor
Group=chain-monitor
WorkingDirectory=/home/ubuntu/chain-monitor
ExecStart=/home/ubuntu/chain-monitor/chain-monitor -config=/home/ubuntu/chain-monitor/config.yml -log-format=json -log-level=info
Restart=on-failure
RestartSec=5
# Finish current height then exit on SIGTERM.
TimeoutStopSec=30
KillSignal=SIGTERM
Environment=GOMEMLIMIT=756MiB
# Comma-separated reporter addresses watched on weak aggregates (missing_reporters enrich).
# Environment=IMPORTANT_REPORTERS=tellor1abc...,tellor1def...
# Optional LCD base if not set in config api.url:
# Environment=LAYER_API_URL=http://127.0.0.1:1317
MemoryMax=800M

[Install]
WantedBy=multi-user.target
